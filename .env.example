# Neon Postgres. Production: leave out &schema=dev. Direct URL = pooled URL without "-pooler" in the host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15&schema=dev"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15&schema=dev"

# Random 64 hex characters. Required in production.
SESSION_SECRET=""

# Random 64 hex characters. Encrypts the networks' access tokens in the database. Required in production
# once real accounts are connected. Changing it later means every real account must be connected again.
TOKEN_ENCRYPTION_KEY=""

# Meta app (developers.facebook.com) for real Facebook Pages and Instagram. Without these, only demo accounts exist.
# The app's Facebook Login for Business must list APP_URL + /api/connect/meta/callback as a valid OAuth redirect URI.
META_APP_ID=""
META_APP_SECRET=""
META_LOGIN_CONFIG_ID=""
# The app's public address, e.g. https://YOUR-APP.onrender.com. Locally: http://localhost:3000
APP_URL=""

# Share of mock publishes that fail at random (0-1). A caption containing #fail always fails.
MOCK_FAIL_RATE="0"

# Cloudflare R2 media storage. Without these, development stores uploads on disk and production refuses uploads.
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
# Folder for files from this environment. Use "dev" locally and leave it unset in production.
R2_PREFIX="dev"
